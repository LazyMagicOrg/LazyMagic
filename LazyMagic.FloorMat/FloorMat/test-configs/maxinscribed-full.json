{
  "testName": "Max Inscribed Full Test Suite (Hybrid Algorithm)",
  "algorithm": "maxinscribed",
  "svgPath": "../../BlazorTest.WASM/wwwroot/Level1-normal.svg",
  "outputDir": "../TestResults/MaxInscribedResults",
  "timeout": 3600000,

  "algorithmOptions": {
    "coverageThreshold": 0,
    "maxTime": 5000,
