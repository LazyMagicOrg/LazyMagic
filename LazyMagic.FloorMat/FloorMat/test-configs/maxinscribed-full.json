    "binarySearchPrecision": 0.0001,
    "binarySearchMaxIterations": 20,
    "debugMode": false
  },

  "combinationsFile": "../valid-combinations-maxinscribed-full.json",

  "outputOptions": {
    "generateSVG": true,
    "generateJSON": true,
    "generateSummary": true,
    "deleteExistingResults": true
  }
