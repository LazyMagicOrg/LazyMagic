{
  "testName": "Boardroom Full Test Suite (Unified Algorithm)",
  "algorithm": "boardroom",
  "svgPath": "../../BlazorTest.WASM/wwwroot/Level1-normal.svg",
  "outputDir": "../TestResults/BoardroomResults",
  "timeout": 3600000,

  "algorithmOptions": {
    "width": {
      "mode": "fixed",
      "value": 13
    },
    "height": {
      "mode": "continuous",
      "min": 6,
      "max": 1000,
      "samples": 25
    },
    "angleSamples": 25,
    "centroidSamples": 25,
    "debugMode": false
  },

  "combinationsFile": "../valid-combinations.json",

  "outputOptions": {
    "generateSVG": true,
    "generateJSON": true,
    "generateSummary": true,
    "deleteExistingResults": true
  }
}
