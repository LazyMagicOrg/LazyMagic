<Project>
	<!-- Common properties for package handling -->
	<PropertyGroup>
		<!-- Note that this .targets file lives in the solution folder, so MSBuildThisFileDirectory is the solution folder,
		     regardless of which project the CommonPackageHandling.targets file is used in. -->
		<PackageRepoFolder>$(SolutionDir)Packages\</PackageRepoFolder>
		<Copyright>Copyright (c) 2021 - 2026 Insight Sciences Corporation. All rights reserved.</Copyright>
		<PackageProjectUrl>https://LazyMagic.org</PackageProjectUrl>
		<RepositoryUrl>https://github.com/LazyMagicOrg/LazyMagic</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<Company>Insight Sciences Corporation</Company>
		<Authors>Tim May, Thomas May</Authors>
		<Version>3.0.17</Version>
		<SignAssembly>false</SignAssembly>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<NoWarn>NU1507;NU1504</NoWarn>
	</PropertyGroup>
	
	<Target Name="CopyPackageLicense" BeforeTargets="Clean">
		<Copy SourceFiles="$(MSBuildThisFileDirectory)\LICENSE.txt" DestinationFiles="LICENSE.txt" />
	</Target>

	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json"/>
		<Content Include="**\*.cs" Pack="true" PackagePath="src\" />
	</ItemGroup>	
	
	<ItemGroup>
		<None Include="LICENSE.txt" Pack="True" PackagePath=""/>
	</ItemGroup>

	<!-- Copy Package Target -->
	<Target Name="CopyPackage" AfterTargets="Pack">
		<PropertyGroup>
			<!-- Pack names its output <PackageId>.<normalized PackageVersion>, which is NOT
			     $(AssemblyName).$(Version): PackageId need not equal AssemblyName, build metadata
			     (+g1a2b3c) is dropped from the file name though not from $(Version), and a fourth part of
			     .0 is dropped. Each made the old Copy fail with MSB3030 and leave the feed with no package
			     for this id. The rules are applied HERE, in a target that runs after Pack, because that is
			     when a version tool has had its say.

			     @(NuGetPackOutput) looks like the authoritative list and is not: it comes from
			     _GetOutputItemsFromPack, whose only DependsOnTargets is _GetAbsoluteOutputPathsForPack
			     (NuGet.Build.Tasks.Pack.targets), so it never waits for $(GetPackageVersionDependsOn) and
			     can predict a name pack does not write - observed 2026-09-05: predicted <id>.1.0.0 while
			     pack wrote <id>.8.8.8-alpha.2. The version is read late instead, and only files that
			     actually exist are copied.

			     $(PackageOutputPath) rather than a hardcoded bin\$(Configuration)\, so `dotnet pack -o`
			     no longer breaks the copy. -->
			<_PkgId>$(PackageId)</_PkgId>
			<_PkgId Condition=" '$(_PkgId)' == '' ">$(AssemblyName)</_PkgId>
			<_PkgVersion>$(PackageVersion)</_PkgVersion>
			<_PkgVersion Condition=" '$(_PkgVersion)' == '' ">$(Version)</_PkgVersion>
			<_PkgVersion>$([System.Text.RegularExpressions.Regex]::Replace('$(_PkgVersion)', '[+].*$', ''))</_PkgVersion>
			<_PkgVersion>$([System.Text.RegularExpressions.Regex]::Replace('$(_PkgVersion)', '^([0-9]+[.][0-9]+[.][0-9]+)[.]0(?=$|-)', '$1'))</_PkgVersion>
			<_PkgDir>$(PackageOutputPath)</_PkgDir>
			<_PkgDir Condition=" '$(_PkgDir)' == '' ">$(BaseOutputPath)$(Configuration)\</_PkgDir>
			<_PkgDir>$([MSBuild]::EnsureTrailingSlash('$(_PkgDir)'))</_PkgDir>
		</PropertyGroup>
		<ItemGroup>
			<_ProducedPackages Include="$(_PkgDir)$(_PkgId).$(_PkgVersion).nupkg" Condition="Exists('$(_PkgDir)$(_PkgId).$(_PkgVersion).nupkg')" />
			<_ProducedPackages Include="$(_PkgDir)$(_PkgId).$(_PkgVersion).snupkg" Condition="Exists('$(_PkgDir)$(_PkgId).$(_PkgVersion).snupkg')" />
		</ItemGroup>
		<Warning Condition="'@(_ProducedPackages)' == '' AND '$(IsPackable)' != 'false'" Text="Pack produced no $(_PkgId).$(_PkgVersion).nupkg in $(_PkgDir); nothing was published to $(PackageRepoFolder)." />
		<Message Condition="'@(_ProducedPackages)' != ''" Importance="high" Text="Copying @(_ProducedPackages->'%(Filename)%(Extension)', ', ') to $(PackageRepoFolder)" />
		<MakeDir Condition="'@(_ProducedPackages)' != ''" Directories="$(PackageRepoFolder)" />
		<Copy Condition="'@(_ProducedPackages)' != ''" SourceFiles="@(_ProducedPackages)" DestinationFolder="$(PackageRepoFolder)" />
	</Target>

	<!-- Once the new package is in the feed, remove this id's SUPERSEDED packages, so the feed holds one
	     version per id. It runs after CopyPackage on purpose: if the copy fails, the previous version stays
	     in the feed instead of leaving the id with nothing. The version just produced is excluded, so a
	     same-version rebuild - the ordinary edit-and-build loop, under fixed and derived versions alike -
	     deletes nothing, because the exclusion is the set of files CopyPackage just wrote rather than a
	     second reimplementation of pack's naming rules. The target does not run at all when pack
	     produced nothing, so a feed can never be emptied for an id this build did not replace. Under a derived version every commit is a new file name, and this is the only
	     thing that stops the feed growing without bound (MigrationPlan section 2).

	     ANCHORED ON THE VERSION, deliberately. A bare "$(PackageId).*.nupkg" glob would also match every
	     package whose id merely EXTENDS this one - LazyMagic.Shared.*.nupkg would sweep
	     LazyMagic.Shared.Notifications.3.0.17.nupkg the moment such a glob reached the LazyMagic feed - so
	     the glob only narrows the candidates and a regex then requires "<id>." followed by a digit-led
	     version. The regexes use character classes and never a backslash: MSBuild on Linux/macOS rewrites
	     literal backslashes in property values to slashes, which silently turned an earlier draft of this
	     target into a no-op there. -->
	<Target Name="CleanExistingPackages" AfterTargets="CopyPackage" Condition="'@(_ProducedPackages)' != ''">
		<PropertyGroup>
			<_CleanId>$(PackageId)</_CleanId>
			<_CleanId Condition=" '$(_CleanId)' == '' ">$(AssemblyName)</_CleanId>
			<_OwnPackagePattern>(?i)^$([System.Text.RegularExpressions.Regex]::Escape('$(_CleanId)'))[.][0-9]+([.][0-9]+){1,3}(-[0-9a-z][0-9a-z.-]*)?([+][0-9a-z][0-9a-z.-]*)?[.]s?nupkg$</_OwnPackagePattern>
		</PropertyGroup>
		<ItemGroup>
			<_FeedCandidates Include="$(PackageRepoFolder)\$(_CleanId).*.nupkg;$(PackageRepoFolder)\$(_CleanId).*.snupkg"
			                 Exclude="@(_ProducedPackages->'$(PackageRepoFolder)\%(Filename)%(Extension)')" />
			<_OwnPackages Include="@(_FeedCandidates)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(_FeedCandidates.Filename)%(_FeedCandidates.Extension)', '$(_OwnPackagePattern)'))" />
		</ItemGroup>
		<Message Condition="'@(_OwnPackages)' != ''" Importance="high" Text="Removing superseded $(_CleanId) packages from the feed: @(_OwnPackages->'%(Filename)%(Extension)', ', ')" />
		<!-- A superseded file another process still has open is not worth failing the build over; it is
		     swept on the next build. -->
		<Delete Files="@(_OwnPackages)" TreatErrorsAsWarnings="true" Retries="2" RetryDelayMilliseconds="250" />
	</Target>
	
	<!-- Evict this project's package from the NuGet global-packages folder after every build, so the
	     next restore in a consumer re-extracts it from the feed instead of serving the cached copy.
	     A same-version repack is the ORDINARY case, not a legacy one: a derived version is a function
	     of git state, and the edit-and-rebuild loop does not advance the commit, so it recomputes the
	     same version and rewrites the same package with different bytes. Without eviction a consumer
	     keeps building against the stale bytes.

	     DeleteSpecificPackage runs in THIS project instance (DependsOnTargets), never through a child
	     <MSBuild> call. The child call re-evaluated the project from scratch, where $(Version) was the
	     STATIC value: a version tool (Nerdbank.GitVersioning) sets the version inside a target, which a
	     child evaluation never runs, so it would have evicted <id>/1.0.0 - the SDK default - while
	     never touching the version actually built (MigrationPlan section 2). -->
	<!--
	     SKIPPED IN THE CROSS-TARGETING OUTER BUILD. A project with <TargetFrameworks> (plural, even a
	     single-entry list - nine LazyMagic projects are exactly that) builds in two passes: an outer
	     pass that dispatches to one inner build per framework, then the inner builds. A version tool
	     sets the version inside a TARGET, and the outer pass runs none of those targets, so there
	     $(Version) is whatever STATIC evaluation left. Three states, verified 2026-09-05 against these
	     targets: with no version tool installed both passes agree and this target is merely redundant
	     (today); with a tool installed and the static <Version> lines still present the outer pass
	     evicts the STATIC version while the build produces the derived one - it took out a cached
	     0.11.1 in the probe, which for a producer is a real published version; and once those lines
	     are deleted it evicts the SDK default <id>/1.0.0 (the 2026-09-05 NBGV spike logged seven
	     "No cached ... 1.0.0" lines per build). All three are the same failure the child <MSBuild>
	     re-entry used to cause, reached by another route. The inner builds evict the version actually
	     built, so skipping the outer pass loses nothing. IsCrossTargetingBuild is set, with this exact
	     condition, by both Sdks/Microsoft.NET.Sdk/Sdk/Sdk.targets and MSBuild's own
	     Microsoft.Managed.Before.targets (TargetFrameworks set and TargetFramework empty), so the
	     guard holds for non-SDK-style managed projects too; a target Condition is evaluated when the
	     target RUNS, so it sees that value even though this file is imported before the SDK's targets.
	     Single-framework projects are unaffected. Invoking -t:DeleteSpecificPackage by hand is
	     deliberately not guarded. -->
	<Target Name="DeletePackage" AfterTargets="Build" DependsOnTargets="DeleteSpecificPackage"
	        Condition="'$(IsCrossTargetingBuild)' != 'true'" />
	<Target Name="DeleteSpecificPackage">
		<PropertyGroup>
			<!-- Evict from the global-packages folder the restore ACTUALLY used, not a hardcoded
			     ~/.nuget/packages. $(NuGetPackageRoot) comes from the restore-generated nuget.g.props
			     and follows a per-workspace globalPackagesFolder set in the workspace NuGet.Config.
			     NuGet writes a RELOCATED root WITHOUT a trailing separator (the default has one), so
			     it is ensured, or the path collapses to "...\.nuget-packagesbaseapp.viewmodels\1.0.1"
			     and eviction silently no-ops (seen 2026-09-02). Falls back to the NuGet default only
			     when no restore has run. -->
			<_PackageRoot>$(NuGetPackageRoot)</_PackageRoot>
			<_PackageRoot Condition=" '$(_PackageRoot)' == '' AND '$(OS)' == 'Windows_NT' ">$(UserProfile)\.nuget\packages\</_PackageRoot>
			<_PackageRoot Condition=" '$(_PackageRoot)' == '' AND '$(OS)' != 'Windows_NT' ">$(Home)/.nuget/packages/</_PackageRoot>
			<_PackageRoot>$([MSBuild]::EnsureTrailingSlash('$(_PackageRoot)'))</_PackageRoot>
			<!-- The id and version the package was ACTUALLY built with, read here after any version tool
			     has run: PackageVersion is what pack stamps, Version is its default. NuGet names the cache
			     folder by the lower-cased id and the NORMALIZED, lower-cased version - build metadata
			     (+g1a2b3c) is not part of it and a fourth part of 0 is dropped - so the same
			     normalization is applied here. -->
			<_EvictId>$(PackageId)</_EvictId>
			<_EvictId Condition=" '$(_EvictId)' == '' ">$(AssemblyName)</_EvictId>
			<_EvictVersion>$(PackageVersion)</_EvictVersion>
			<_EvictVersion Condition=" '$(_EvictVersion)' == '' ">$(Version)</_EvictVersion>
			<_EvictVersion>$([System.Text.RegularExpressions.Regex]::Replace('$(_EvictVersion)', '[+].*$', ''))</_EvictVersion>
			<_EvictVersion>$([System.Text.RegularExpressions.Regex]::Replace('$(_EvictVersion)', '^([0-9]+[.][0-9]+[.][0-9]+)[.]0(?=$|-)', '$1'))</_EvictVersion>
			<_EvictVersion>$(_EvictVersion.ToLowerInvariant())</_EvictVersion>
			<PackageCacheFolder Condition=" '$(OS)' == 'Windows_NT' ">$(_PackageRoot)$(_EvictId.ToLowerInvariant())\$(_EvictVersion)</PackageCacheFolder>
			<PackageCacheFolder Condition=" '$(OS)' != 'Windows_NT' ">$(_PackageRoot)$(_EvictId.ToLowerInvariant())/$(_EvictVersion)</PackageCacheFolder>
		</PropertyGroup>
		<!-- Three honest outcomes, decided by STATE rather than by exit code. On Windows `rmdir /s /q`
		     exits 0 when a file inside is in use and it deleted only what it could (the review's probe:
		     exit 0, .nupkg.metadata gone, the locked dll and the folder left), so an exit-code test
		     reported that as "Evicted". Exists() in a task condition is evaluated when the task runs,
		     after the Exec, and sees the post-deletion state. The exit-code guard only tells "the Exec
		     ran" from the nothing-to-evict case above. (The pre-2026-09-05 pair reported "Failed to
		     delete package. Error code: " on the NOTHING-TO-EVICT path: the Exec never ran, the exit
		     code stayed empty, and '' != '0' is true.) -->
		<!-- A destructive delete NEVER runs on a version we could not determine. With $(_EvictVersion)
		     empty the path collapses to the id root and rmdir takes EVERY cached version of the package:
		     verified 2026-09-05 on an unguarded copy, where four seeded versions and the id folder
		     itself were reported as one "Evicted ...\lz.scratch.multi\" and were gone. Nothing upstream
		     should ever produce an empty version - the SDK defaults it, and the two fallbacks above
		     cover an unset PackageId - so this is a bug detector, not a fallback path, and it warns
		     rather than passing silently. It does not depend on the caller: the cross-targeting guard on
		     DeletePackage happens to close the only route found so far, but a destructive target must be
		     safe on its own. -->
		<Warning Condition=" '$(_EvictVersion)' == '' " Text="No version could be determined for $(_EvictId); skipping the package-cache eviction rather than deleting every cached version of it. The build is producing a package whose version this target cannot see - check the version tool and any &lt;Version&gt; override." />
		<Message Condition=" '$(_EvictVersion)' != '' AND !Exists('$(PackageCacheFolder)')" Importance="high" Text="No cached $(_EvictId) $(_EvictVersion) under $(_PackageRoot) - nothing to evict." />
		<Exec Condition=" '$(OS)' == 'Windows_NT' AND '$(_EvictVersion)' != '' AND Exists('$(PackageCacheFolder)')"
			  Command="cmd.exe /c &quot;if exist &quot;$(PackageCacheFolder)&quot; rmdir /s /q &quot;$(PackageCacheFolder)&quot;&quot;"
			  ContinueOnError="true">
			<Output TaskParameter="ExitCode" PropertyName="_EvictExitCode"/>
		</Exec>
		<Exec Condition=" '$(OS)' != 'Windows_NT' AND '$(_EvictVersion)' != '' AND Exists('$(PackageCacheFolder)')"
			  Command="rm -rf &quot;$(PackageCacheFolder)&quot;"
			  ContinueOnError="true">
			<Output TaskParameter="ExitCode" PropertyName="_EvictExitCode"/>
		</Exec>
		<Message Condition="'$(_EvictExitCode)' != '' AND !Exists('$(PackageCacheFolder)')" Importance="high" Text="Evicted $(PackageCacheFolder); the next restore re-extracts $(_EvictId) $(_EvictVersion) from the feed." />
		<Warning Condition="'$(_EvictExitCode)' != '' AND Exists('$(PackageCacheFolder)')" Text="Could not evict $(PackageCacheFolder) (exit $(_EvictExitCode); a file inside is probably in use) - a consumer may restore a STALE $(_EvictId) $(_EvictVersion). Close whatever holds it and rebuild." />
	</Target>
</Project>
