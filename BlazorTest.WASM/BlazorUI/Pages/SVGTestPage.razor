@namespace BlazorUI
@page "/SVGTestPage"
@using LazyMagic.BlazorSvg
@using LazyMagic.BlazorSvg.Models
@using BlazorUI.Components

<PageTitle>SVGTest</PageTitle>

<h1>SVGTestPage</h1>

<div class="alert alert-info mb-3">
    <strong>Real-time Selection Test:</strong> This page demonstrates SVG real-time selection and bounding box functionality.
    <br />
    <strong>Initial State:</strong> Starting with paths "Ballroom_Room_1" and "Ballroom_Room_3" selected.
    <br />
    <strong>Features:</strong> Real-time grouping and bounding box visualization for selected paths.
</div>

<SvgViewer @ref="@svgViewer"
    InitialPaths="@initialPaths"
    SvgUrl="Level1.svg"
    PathsChanged="OnPathsChanged"
    @bind-AllInsideSelected="@allInsideSelected"
    RectangleType="@rectangleType"/>

<div class="mt-3">
    <div>Initial Paths: <code>@(string.Join(", ", initialPaths))</code></div>
    <div>Currently Selected: <code>@(string.Join(", ", currentPaths.Any() ? currentPaths : initialPaths))</code></div>
    <div>All Inside Selected: <strong>@(allInsideSelected ? "✅ YES - All paths within bounding box are selected" : "❌ NO - Some paths within bounding box are NOT selected")</strong></div>
    @if (areaData != null && areaData.PolygonArea.HasValue)
    {
        var comboArea = areaData.PolygonArea.Value;

        <div class="mt-2">
            <strong>Area Measurements (Square SVG Inches):</strong>
            <div class="ms-3">
                <div>Combo Area: <code>@($"{comboArea:F2}")</code> sq in</div>

                @if (rectangleType == "maxinscribed" && areaData.RectangleArea.HasValue)
                {
                    var rectArea = areaData.RectangleArea.Value;
                    // If rectangle area is larger than combo area (algorithm error), use combo area
                    if (rectArea > comboArea)
                    {
                        rectArea = comboArea;
                    }
                    <div>Max Inscribed Rectangle Area: <code>@($"{rectArea:F2}")</code> sq in</div>
                }

                @if (rectangleType == "boardroom" && areaData.BoardroomArea.HasValue)
                {
                    var boardroomArea = areaData.BoardroomArea.Value;
                    <div>Boardroom Layout Area: <code>@($"{boardroomArea:F2}")</code> sq in</div>
                    @if (areaData.BoardroomSets.HasValue && areaData.BoardroomTables.HasValue)
                    {
                        <div class="ms-3">
                            <small>(@areaData.BoardroomSets sets, @areaData.BoardroomTables tables)</small>
                        </div>
                    }
                }

                @if (rectangleType == "hollowsquare" && areaData.HollowSquareArea.HasValue)
                {
                    var hollowSquareArea = areaData.HollowSquareArea.Value;
                    <div>Hollow Square Layout Area: <code>@($"{hollowSquareArea:F2}")</code> sq in</div>
                }
            </div>
        </div>
    }
</div>

@if (allInsideSelected)
{
    <div class="alert alert-success mt-2">
        ✅ All paths inside the bounding box are selected! The selection is complete.
    </div>
}
else if (currentPaths.Count > 1 || initialPaths.Count > 1)
{
    <div class="alert alert-warning mt-2">
        ⚠️ Partial selection detected. There are unselected paths within the bounding box created by your selection.
    </div>
}

<div class="mt-4">
    <h5>Test Controls:</h5>
    <div class="row">
        <div class="col-md-6">
            <button class="btn btn-info mb-2" @onclick="TestSelect">TestSelect (Add Ballroom_Room_2)</button>
        </div>
    </div>
    <div class="row mt-2">
        <div class="col-md-12">
            <h6>Rectangle Display:</h6>
            <div class="mb-2">
                <label for="rectangleType" class="form-label">Select Rectangle Type:</label>
                <select class="form-select" id="rectangleType" @bind="rectangleType" @bind:after="OnRectangleTypeChanged">
                    <option value="none">None</option>
                    <option value="maxinscribed">Max Inscribed Rectangle (Orange)</option>
                    <option value="boardroom">Boardroom Layout (Blue)</option>
                    <option value="hollowsquare">Hollow Square Layout (Purple)</option>
                </select>
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <h5>Test Instructions:</h5>
    <ul>
        <li><strong>Real-time Selection:</strong> Click on SVG paths to select/unselect them</li>
        <li><strong>Bounding Box:</strong> Automatically displays around selected paths with overlap detection</li>
        <li><strong>Visual Indicators:</strong> Selected paths change color and bounding box appears</li>
        <li><strong>Auto-grouping:</strong> Real-time grouping visualization shows automatically for selections</li>
    </ul>
</div>

<div class="mt-4">
    <h5>Floor Metadata:</h5>
    <button class="btn btn-primary mb-3" @onclick="LoadMetadata">Load Floor Metadata</button>
    @if (isLoadingMetadata)
    {
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    }
    @if (metadataError != null)
    {
        <div class="alert alert-danger">
            <strong>Error:</strong> @metadataError
        </div>
    }
</div>

<FloorLevelDisplay FloorLevel="@floorMetadata" />

@code {
    private List<string> currentPaths = new();
    private SvgViewer? svgViewer;
    // Initialize with multiple paths that create a bounding box
    // If there are other paths inside this bounding box that aren't selected,
    // AllInsideSelected should be false initially
    private List<string> initialPaths = new List<string> { "Ballroom_Room_1", "Ballroom_Room_3" };
    private bool allInsideSelected = false;
    private AreaData? areaData = null;
    private string rectangleType = "none";
    private FloorLevel? floorMetadata = null;
    private bool isLoadingMetadata = false;
    private string? metadataError = null;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }

    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
       await base.OnAfterRenderAsync(firstRender);

       if (firstRender)
       {
           // Give the SVG time to initialize
           await Task.Delay(500);
           await UpdateAreaData();
       }
    }

    private async void OnPathsChanged(List<string> paths)
    {
        currentPaths = paths;
        await UpdateAreaData();
        StateHasChanged();
    }

    private async Task UpdateAreaData()
    {
        if (svgViewer != null)
        {
            areaData = await svgViewer.GetAreaDataAsync();
        }
    }

    private async Task TestSelect()
    {
        var paths = new List<string> { "Ballroom_Room_2" };
        await svgViewer!.SelectPaths(paths);
    }

    private async Task OnRectangleTypeChanged()
    {
        if (svgViewer != null)
        {
            // Directly update the rectangle type in the SvgViewer
            await svgViewer.SetRectangleTypeAsync(rectangleType);

            // Refresh the area data display
            await UpdateAreaData();

            // Update the UI
            StateHasChanged();
        }
    }

    private async Task LoadMetadata()
    {
        if (svgViewer == null)
        {
            metadataError = "SVG Viewer not initialized";
            return;
        }

        isLoadingMetadata = true;
        metadataError = null;
        StateHasChanged();

        try
        {
            // Give the SVG time to fully load if needed
            await Task.Delay(500);

            floorMetadata = await svgViewer.GetFloorMetadataAsync();
            if (floorMetadata == null)
            {
                metadataError = "Failed to extract metadata from SVG. Make sure the SVG is fully loaded.";
            }
        }
        catch (Exception ex)
        {
            metadataError = $"Error loading metadata: {ex.Message}";
        }
        finally
        {
            isLoadingMetadata = false;
            StateHasChanged();
        }
    }

}