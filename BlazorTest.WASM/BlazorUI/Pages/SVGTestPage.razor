@namespace BlazorUI
@page "/SVGTestPage"
@using LazyMagic.BlazorSvg
@using LazyMagic.BlazorSvg.Models
@using BlazorUI.Components

<PageTitle>SVGTest</PageTitle>

<h1>SVGTestPage</h1>

<div class="alert alert-info mb-3">
    <strong>Real-time Selection Test:</strong> This page demonstrates SVG real-time selection and bounding box functionality.
    <br />
    <strong>Initial State:</strong> Starting with paths "Ballroom_Room_1" and "Ballroom_Room_3" selected.
    <br />
    <strong>Features:</strong> Real-time grouping and bounding box visualization for selected paths.
</div>

<SvgViewer @ref="@svgViewer"
    InitialPaths="@initialPaths"
    SvgUrl="Level1.svg?v=16"
    PathsChanged="OnPathsChanged"
    @bind-AllInsideSelected="@allInsideSelected"
    RectangleType="@rectangleType"/>

<div class="mt-3 card">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Available Rectangle Layouts</h5>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-sm table-hover">
                <thead>
                    <tr>
                        <th>Layout Type</th>
                        <th>Description</th>
                        <th>Area (sq in)</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr class="@(rectangleType == "none" ? "table-active" : "")" style="cursor: pointer;" @onclick='() => SelectRectangleType("none")'>
                        <td><strong>None</strong></td>
                        <td>No rectangle overlay</td>
                        <td>
                            @if (areaData?.PolygonArea != null)
                            {
                                <text>@areaData.PolygonArea.Value.ToString("F2")</text>
                            }
                            else
                            {
                                <em class="text-muted">N/A</em>
                            }
                        </td>
                        <td>@(rectangleType == "none" ? "✓ Active" : "")</td>
                    </tr>
                    <tr class="@(rectangleType == "maxinscribed" ? "table-active" : "")" style="cursor: pointer;" @onclick='() => SelectRectangleType("maxinscribed")'>
                        <td><strong style="color: #FF8800;">Max Inscribed</strong></td>
                        <td>Largest rectangle that fits inside the polygon</td>
                        <td>
                            @if (areaData?.RectangleArea != null)
                            {
                                <text>@areaData.RectangleArea.Value.ToString("F2")</text>
                            }
                            else
                            {
                                <em class="text-muted">N/A</em>
                            }
                        </td>
                        <td>@(rectangleType == "maxinscribed" ? "✓ Active" : "")</td>
                    </tr>
                    <tr class="@(rectangleType == "boardroom" ? "table-active" : "")" style="cursor: pointer;" @onclick='() => SelectRectangleType("boardroom")'>
                        <td><strong style="color: #0000FF;">Boardroom</strong></td>
                        <td>Boardroom seating layout</td>
                        <td>
                            @if (areaData?.BoardroomArea != null)
                            {
                                <text>@areaData.BoardroomArea.Value.ToString("F2")</text>
                            }
                            else
                            {
                                <em class="text-muted">N/A</em>
                            }
                        </td>
                        <td>@(rectangleType == "boardroom" ? "✓ Active" : "")</td>
                    </tr>
                    <tr class="@(rectangleType == "hollowsquare" ? "table-active" : "")" style="cursor: pointer;" @onclick='() => SelectRectangleType("hollowsquare")'>
                        <td><strong style="color: #800080;">Hollow Square</strong></td>
                        <td>Hollow square seating layout</td>
                        <td>
                            @if (areaData?.HollowSquareArea != null)
                            {
                                <text>@areaData.HollowSquareArea.Value.ToString("F2")</text>
                            }
                            else
                            {
                                <em class="text-muted">N/A</em>
                            }
                        </td>
                        <td>@(rectangleType == "hollowsquare" ? "✓ Active" : "")</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (selectedSections.Any())
{
    <div class="mt-3 card">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0">Selected Sections Details</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm table-striped">
                    <thead>
                        <tr>
                            <th>Section Name</th>
                            <th>FloorMat Area</th>
                            <th>Polygon Area</th>
                            <th>Width × Depth</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var roomSection in selectedSections)
                        {
                            <tr>
                                <td><strong>@roomSection.Name</strong></td>
                                <td>
                                    @if (roomSection.FloormatArea.HasValue)
                                    {
                                        <text>@roomSection.FloormatArea.Value.ToString("F2") sq ft</text>
                                    }
                                    else
                                    {
                                        <em class="text-muted">Not specified</em>
                                    }
                                </td>
                                <td>
                                    @if (roomSection.PolygonArea.HasValue)
                                    {
                                        <text>@roomSection.PolygonArea.Value.ToString("F2")</text>
                                    }
                                    else
                                    {
                                        <em class="text-muted">Not computed</em>
                                    }
                                </td>
                                <td>
                                    @if (roomSection.Width.HasValue && roomSection.Depth.HasValue)
                                    {
                                        <text>@roomSection.Width.Value.ToString("F1") × @roomSection.Depth.Value.ToString("F1") ft</text>
                                    }
                                    else
                                    {
                                        <em class="text-muted">N/A</em>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<div class="mt-3">
    <div>Initial Paths: <code>@(string.Join(", ", initialPaths))</code></div>
    <div>Currently Selected: <code>@(string.Join(", ", currentPaths.Any() ? currentPaths : initialPaths))</code></div>
    <div>All Inside Selected: <strong>@(allInsideSelected ? "✅ YES - All paths within bounding box are selected" : "❌ NO - Some paths within bounding box are NOT selected")</strong></div>
    @if (areaData != null && areaData.PolygonArea.HasValue)
    {
        var comboArea = areaData.PolygonArea.Value;

        <div class="mt-2">
            <strong>Area Measurements (Square SVG Inches):</strong>
            <div class="ms-3">
                <div>Combo Area: <code>@($"{comboArea:F2}")</code> sq in</div>

                @if (rectangleType == "maxinscribed" && areaData.RectangleArea.HasValue)
                {
                    var rectArea = areaData.RectangleArea.Value;
                    // If rectangle area is larger than combo area (algorithm error), use combo area
                    if (rectArea > comboArea)
                    {
                        rectArea = comboArea;
                    }
                    <div>Max Inscribed Rectangle Area: <code>@($"{rectArea:F2}")</code> sq in</div>
                }

                @if (rectangleType == "boardroom" && areaData.BoardroomArea.HasValue)
                {
                    var boardroomArea = areaData.BoardroomArea.Value;
                    <div>Boardroom Layout Area: <code>@($"{boardroomArea:F2}")</code> sq in</div>
                    @if (areaData.BoardroomSets.HasValue && areaData.BoardroomTables.HasValue)
                    {
                        <div class="ms-3">
                            <small>(@areaData.BoardroomSets sets, @areaData.BoardroomTables tables)</small>
                        </div>
                    }
                }

                @if (rectangleType == "hollowsquare" && areaData.HollowSquareArea.HasValue)
                {
                    var hollowSquareArea = areaData.HollowSquareArea.Value;
                    <div>Hollow Square Layout Area: <code>@($"{hollowSquareArea:F2}")</code> sq in</div>
                }
            </div>
        </div>
    }
</div>

@if (allInsideSelected)
{
    <div class="alert alert-success mt-2">
        ✅ All paths inside the bounding box are selected! The selection is complete.
    </div>
}
else if (currentPaths.Count > 1 || initialPaths.Count > 1)
{
    <div class="alert alert-warning mt-2">
        ⚠️ Partial selection detected. There are unselected paths within the bounding box created by your selection.
    </div>
}

<div class="mt-4">
    <h5>Test Controls:</h5>
    <div class="row">
        <div class="col-md-6">
            <button class="btn btn-info mb-2" @onclick="TestSelect">TestSelect (Add Ballroom_Room_2)</button>
        </div>
    </div>
</div>

<div class="mt-4">
    <h5>Test Instructions:</h5>
    <ul>
        <li><strong>Real-time Selection:</strong> Click on SVG paths to select/unselect them</li>
        <li><strong>Bounding Box:</strong> Automatically displays around selected paths with overlap detection</li>
        <li><strong>Visual Indicators:</strong> Selected paths change color and bounding box appears</li>
        <li><strong>Auto-grouping:</strong> Real-time grouping visualization shows automatically for selections</li>
    </ul>
</div>

<div class="mt-4">
    <h5>Floor Metadata:</h5>
    <button class="btn btn-primary mb-3" @onclick="LoadMetadata">Load Floor Metadata</button>
    @if (isLoadingMetadata)
    {
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    }
    @if (metadataError != null)
    {
        <div class="alert alert-danger">
            <strong>Error:</strong> @metadataError
        </div>
    }
</div>

<FloorLevelDisplay FloorLevel="@floorMetadata" />

@code {
    private List<string> currentPaths = new();
    private SvgViewer? svgViewer;
    // Initialize with multiple paths that create a bounding box
    // If there are other paths inside this bounding box that aren't selected,
    // AllInsideSelected should be false initially
    private List<string> initialPaths = new List<string> { "Ballroom_Room_1", "Ballroom_Room_3" };
    private bool allInsideSelected = false;
    private AreaData? areaData = null;
    private string rectangleType = "maxinscribed";
    private FloorLevel? floorMetadata = null;
    private bool isLoadingMetadata = false;
    private string? metadataError = null;
    private List<RoomSection> selectedSections = new();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }

    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
       await base.OnAfterRenderAsync(firstRender);

       if (firstRender)
       {
           // Give the SVG time to initialize
           await Task.Delay(500);
           await UpdateAreaData();

           // Automatically load metadata on page load
           await LoadMetadata();
       }
    }

    private async void OnPathsChanged(List<string> paths)
    {
        currentPaths = paths;
        await UpdateAreaData();
        UpdateSelectedSections();
        StateHasChanged();
    }

    private async Task UpdateAreaData()
    {
        if (svgViewer != null)
        {
            areaData = await svgViewer.GetAreaDataAsync();
        }
    }

    private async Task TestSelect()
    {
        var paths = new List<string> { "Ballroom_Room_2" };
        await svgViewer!.SelectPaths(paths);
    }

    private async Task SelectRectangleType(string type)
    {
        Console.WriteLine($"[SVGTestPage] SelectRectangleType called with: {type}");
        rectangleType = type;

        if (svgViewer != null)
        {
            Console.WriteLine($"[SVGTestPage] Calling SetRectangleTypeAsync with: {rectangleType}");

            // Call the public method to update the rectangle type
            await svgViewer.SetRectangleTypeAsync(rectangleType);

            // Small delay to let the JS update complete
            await Task.Delay(100);

            // Refresh the area data display
            await UpdateAreaData();

            Console.WriteLine($"[SVGTestPage] Rectangle type update complete");
        }
        else
        {
            Console.WriteLine("[SVGTestPage] svgViewer is null, cannot update rectangle type");
        }

        // Update the UI
        StateHasChanged();
    }

    private async Task OnRectangleTypeChanged()
    {
        Console.WriteLine($"[SVGTestPage] Rectangle type changed to: {rectangleType}");

        if (svgViewer != null)
        {
            // Directly update the rectangle type in the SvgViewer
            Console.WriteLine($"[SVGTestPage] Calling SetRectangleTypeAsync with: {rectangleType}");
            await svgViewer.SetRectangleTypeAsync(rectangleType);

            // Refresh the area data display
            await UpdateAreaData();

            // Update the UI
            StateHasChanged();
        }
        else
        {
            Console.WriteLine("[SVGTestPage] svgViewer is null, cannot update rectangle type");
        }
    }

    private async Task LoadMetadata()
    {
        if (svgViewer == null)
        {
            metadataError = "SVG Viewer not initialized";
            return;
        }

        isLoadingMetadata = true;
        metadataError = null;
        StateHasChanged();

        try
        {
            // Give the SVG time to fully load if needed
            await Task.Delay(500);

            floorMetadata = await svgViewer.GetFloorMetadataAsync();
            if (floorMetadata == null)
            {
                metadataError = "Failed to extract metadata from SVG. Make sure the SVG is fully loaded.";
            }
            else
            {
                UpdateSelectedSections();
            }
        }
        catch (Exception ex)
        {
            metadataError = $"Error loading metadata: {ex.Message}";
        }
        finally
        {
            isLoadingMetadata = false;
            StateHasChanged();
        }
    }

    private void UpdateSelectedSections()
    {
        selectedSections.Clear();
        if (floorMetadata?.Rooms == null) return;

        var pathIds = currentPaths.Any() ? currentPaths : initialPaths;
        foreach (var room in floorMetadata.Rooms)
        {
            var matchingSections = room.RoomSections.Where(s => pathIds.Contains(s.Id));
            selectedSections.AddRange(matchingSections);
        }
    }

}