@namespace BlazorUI.Components
@using LazyMagic.BlazorSvg.Models

@if (Data != null)
{
    <div class="card mb-3">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Inscribed Rectangle Layouts</h5>
        </div>
        <div class="card-body">
            <p><strong>Project:</strong> @Data.Project</p>
            <p><strong>Generated:</strong> @Data.GeneratedAt</p>
            <p><strong>Total Combinations:</strong> @Data.TotalCombinations</p>
            <p><strong>Successful:</strong> @Data.SuccessfulComputations</p>
            <p><strong>Failed:</strong> @Data.FailedComputations</p>

            @if (Data.Statistics != null)
            {
                <div class="mt-2">
                    <h6>Statistics</h6>
                    <p><strong>Total Layouts:</strong> @Data.Statistics.TotalLayouts</p>
                    <p><strong>Total Time:</strong> @Data.Statistics.TotalComputationTimeSec seconds</p>
                    <p><strong>Average Time:</strong> @Data.Statistics.AverageComputationTimeSec seconds</p>
                </div>
            }

            <div class="mt-3">
                <div class="btn-group" role="group">
                    <button type="button" class="btn @(SelectedType == null ? "btn-primary" : "btn-outline-primary")" @onclick="@(() => SelectedType = null)">
                        All (@Data.Layouts.Count)
                    </button>
                    <button type="button" class="btn @(SelectedType == SvgInscribedRectangleType.MaxInscribed ? "btn-warning" : "btn-outline-warning")" @onclick="@(() => SelectedType = SvgInscribedRectangleType.MaxInscribed)">
                        Max-Inscribed (@GetCount(SvgInscribedRectangleType.MaxInscribed))
                    </button>
                    <button type="button" class="btn @(SelectedType == SvgInscribedRectangleType.Boardroom ? "btn-info" : "btn-outline-info")" @onclick="@(() => SelectedType = SvgInscribedRectangleType.Boardroom)">
                        Boardroom (@GetCount(SvgInscribedRectangleType.Boardroom))
                    </button>
                    <button type="button" class="btn @(SelectedType == SvgInscribedRectangleType.HollowSquare ? "btn-secondary" : "btn-outline-secondary")" @onclick="@(() => SelectedType = SvgInscribedRectangleType.HollowSquare)">
                        Hollow Square (@GetCount(SvgInscribedRectangleType.HollowSquare))
                    </button>
                </div>
            </div>

            <div class="mt-3">
                <h6>@GetLayoutTypeLabel() (@GetFilteredLayouts().Count())</h6>
                <div class="table-responsive">
                    <table class="table table-sm table-striped">
                        <thead>
                            <tr>
                                <th>Type</th>
                                <th>Key</th>
                                <th>Sections</th>
                                <th>Polygon Area</th>
                                <th>Inscribed Area</th>
                                <th>Coverage %</th>
                                @if (SelectedType == SvgInscribedRectangleType.Boardroom || SelectedType == null)
                                {
                                    <th>Sets/Tables</th>
                                }
                                <th>Time (ms)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in GetFilteredLayouts().Take(ShowAll ? GetFilteredLayouts().Count() : 10))
                            {
                                var coverage = item.PolygonArea > 0 ? (item.InscribedArea / item.PolygonArea * 100) : 0;
                                var typeColor = GetTypeColor(item.LayoutType);
                                <tr>
                                    <td><span class="badge bg-@typeColor">@item.LayoutType</span></td>
                                    <td><small>@item.Key</small></td>
                                    <td><small>@item.Sections.Count</small></td>
                                    <td>@item.PolygonArea.ToString("F2")</td>
                                    <td>@item.InscribedArea.ToString("F2")</td>
                                    <td>@coverage.ToString("F1")%</td>
                                    @if (SelectedType == SvgInscribedRectangleType.Boardroom || SelectedType == null)
                                    {
                                        <td>
                                            @if (item.Sets.HasValue && item.Tables.HasValue)
                                            {
                                                <text>@item.Sets / @item.Tables</text>
                                            }
                                            else
                                            {
                                                <text>-</text>
                                            }
                                        </td>
                                    }
                                    <td>@item.ComputationTimeMs</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (GetFilteredLayouts().Count() > 10 && !ShowAll)
                {
                    <button class="btn btn-sm btn-outline-primary" @onclick="@(() => ShowAll = true)">
                        Show All (@GetFilteredLayouts().Count() layouts)
                    </button>
                }
                else if (ShowAll)
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => ShowAll = false)">
                        Show Less
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public SvgInscribedRectangleData? Data { get; set; }

    private SvgInscribedRectangleType? SelectedType { get; set; } = null;
    private bool ShowAll { get; set; } = false;

    private IEnumerable<SvgInscribedRectangleLayout> GetFilteredLayouts()
    {
        if (Data?.Layouts == null) return Enumerable.Empty<SvgInscribedRectangleLayout>();

        if (SelectedType.HasValue)
        {
            return Data.Layouts.Where(l => l.LayoutType == SelectedType.Value);
        }

        return Data.Layouts;
    }

    private int GetCount(SvgInscribedRectangleType type)
    {
        return Data?.Layouts?.Count(l => l.LayoutType == type) ?? 0;
    }

    private string GetLayoutTypeLabel()
    {
        return SelectedType switch
        {
            SvgInscribedRectangleType.MaxInscribed => "Max-Inscribed Rectangles",
            SvgInscribedRectangleType.Boardroom => "Boardroom Layouts",
            SvgInscribedRectangleType.HollowSquare => "Hollow Square Layouts",
            _ => "All Layouts"
        };
    }

    private string GetTypeColor(SvgInscribedRectangleType type)
    {
        return type switch
        {
            SvgInscribedRectangleType.MaxInscribed => "warning",
            SvgInscribedRectangleType.Boardroom => "info",
            SvgInscribedRectangleType.HollowSquare => "secondary",
            _ => "light"
        };
    }
}
