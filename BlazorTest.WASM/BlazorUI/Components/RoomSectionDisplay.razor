@namespace BlazorUI.Components
@using LazyMagic.BlazorSvg.Models

<div class="card mb-2">
    <div class="card-body">
        <h6 class="card-title">@Section.Id</h6>
        @if (!string.IsNullOrEmpty(Section.Name))
        {
            <p class="card-text"><strong>Name:</strong> @Section.Name</p>
        }
        @if (!string.IsNullOrEmpty(Section.Description))
        {
            <p class="card-text"><strong>Description:</strong> @Section.Description</p>
        }
        @if (!string.IsNullOrEmpty(Section.SectionType))
        {
            <p class="card-text"><strong>Type:</strong> @Section.SectionType</p>
        }
        <p class="card-text"><strong>Layout Restriction:</strong> @Section.LayoutRestriction</p>
        @if (!string.IsNullOrEmpty(Section.InkscapeLabel))
        {
            <p class="card-text"><strong>Label:</strong> @Section.InkscapeLabel</p>
        }
        @if (Section.PolygonArea.HasValue)
        {
            <p class="card-text"><strong>Polygon Area:</strong> @($"{Section.PolygonArea.Value:F2}") sq units</p>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public RoomSection Section { get; set; } = null!;
}
