@namespace BlazorUI.Components
@using LazyMagic.BlazorSvg.Models

@if (FloorLevel != null)
{
    <div class="container-fluid mt-4">
        <div class="card mb-4">
            <div class="card-header bg-success text-white">
                <h4 class="mb-0">Floor Level: @FloorLevel.Name</h4>
            </div>
            <div class="card-body">
                <p><strong>ID:</strong> @FloorLevel.Id</p>
                @if (FloorLevel.Diagram != null)
                {
                    <div class="mt-2">
                        <h6>Diagram Information</h6>
                        <p><strong>Image:</strong> @FloorLevel.Diagram.Image</p>
                        <p><strong>Units:</strong> @FloorLevel.Diagram.MeasureUnits (@FloorLevel.Diagram.Unit)</p>
                    </div>
                }
            </div>
        </div>

        <ul class="nav nav-tabs" id="myTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="rooms-tab" data-bs-toggle="tab" data-bs-target="#rooms" type="button" role="tab">
                    Rooms (@FloorLevel.Rooms.Count)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="layouts-tab" data-bs-toggle="tab" data-bs-target="#layouts" type="button" role="tab">
                    Inscribed Rectangle Layouts
                </button>
            </li>
        </ul>

        <div class="tab-content" id="myTabContent">
            <div class="tab-pane fade show active" id="rooms" role="tabpanel">
                <div class="mt-3">
                    @foreach (var room in FloorLevel.Rooms)
                    {
                        <RoomDisplay Room="@room" />
                    }
                </div>
            </div>
            <div class="tab-pane fade" id="layouts" role="tabpanel">
                <div class="mt-3">
                    <InscribedRectangleDataDisplay Data="@FloorLevel.InscribedRectangles" />
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        <p>No floor level metadata available.</p>
        <p>Click the "Load Metadata" button to extract floor plan data from the SVG.</p>
    </div>
}

@code {
    [Parameter]
    public SvgFloorLevel? FloorLevel { get; set; }
}
