<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="$(SolutionDir)CommonPackageHandling.targets" />
	<PropertyGroup>
		<!-- Override 3.0.6 so the GetCallerInfoAsync masking-catch fix (chain the inner
		     exception) re-resolves through the NuGet + container Docker layer caches. -->
		<Version>3.0.7</Version>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<Description>Authorization library</Description>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" />
		<PackageReference Include="Newtonsoft.Json" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\LazyMagic.Shared\LazyMagic.Shared.csproj" />
		<ProjectReference Include="..\LazyMagic.Service.Shared\LazyMagic.Service.Shared.csproj" />	
	</ItemGroup>
</Project>
