		<!-- Remember to update the LazyMagic package versions here for transitive depdenencies
		     introduced when we reference a package as a project in a package. For instance,
			 LazyMagic.Blazor references the LazyMagic.OIDC.Base project but when we reference 
			 LazyMagic.Blazor as a package, it will resolve the LazyMagic.OIDC.Base as version 
			 1.0.0 if we don't put the current version here. -->
		<PackageVersion Include="LazyMagic.OIDC.Base" Version="3.0.17" />
		<PackageVersion Include="LazyMagic.OIDC.WASM.Bff" Version="3.0.17" />
		<PackageVersion Include="LazyMagic.Client.FactoryGenerator" Version="3.0.17" />
